/**
 * Payment Address Transaction Tracker - V2
 * Clean architecture with step-by-step approval
 */

// ============================================================================
// CONFIGURATION
// ============================================================================

const API_BASE = "https://api.koios.rest/api/v1";
const ADDRESS_TXS_ENDPOINT = `${API_BASE}/address_txs`;
const TX_INFO_ENDPOINT = `${API_BASE}/tx_info`;
const BATCH_SIZE = 50;

const BLOCKFROST_BASE = "https://cardano-mainnet.blockfrost.io/api/v0";
const BLOCKFROST_PROJECT_ID = "mainnet99gNifPWc05ZPeBf5MSOgDU4ObehIKio";

const PAYMENT_ADDRESS = "addr1xxzc8pt7fgf0lc0x7eq6z7z6puhsxmzktna7dluahrj6g6v9swzhujsjlls7dajp59u95re0qdk9vh8mumlemw89535s4ecqxj";
const orchStakeAddr = [
  "stake1u8cwz763hsvfvguhg58tvffz908fc5gvhq4jzw7eeut74qsxn4ljv",
  "stake1u8tjgj62samm0hrfp86xgr8s96j827j402vlkjpmqhu8mlsvc72kz",
  "stake1u955v0l4lcy5m4j77sw7j48d7cww8ntd86vxzpsdh0zrflgsjy8rv"
];
const VENDOR_ADDRESSES = [
  "addr1xxyzewehw7dh78ea62mkgdnzmcdlcxqt4u39a7pqc0v0at5g9janwaum0u0nm54hvsmx9hsmlsvqhteztmuzps7cl6hq7d35th"
];

// Key hashes from treasury-contracts-config.json.
// Both hashes per group map to the same display name (anyOf semantics).
const ADMIN_KEY_HASHES = {
  "1be0008bf2994524c0eaf0efdae4431e4a61ef7d974804fa794110b7": "Intersect Admin 1",
  "27194940fae07315f4dc7a0394535dea7795dab2f232ee40f4457e8f": "Intersect Admin 1",
  "a664de561ccd2ca9a07c060d4dd7cea4dc68ba89d4bf04b21ff0726f": "Intersect Admin 2",
  "821dbb013b85872e91f59e5c3c566390c866aea114a13b1b68f064bc": "Intersect Admin 2",
  "c236d8dc9441605238a5fe9cc7e6c1a79903289a4249c33122bf9627": "Intersect Admin 3",
  "1b5850270f7a77ea9ef570a83fb4b120bf814ec94aa0dba0c9c28844": "Intersect Admin 3"
};

const LEADERSHIP_KEY_HASHES = {
  "4e72b1facdc7eea745767b8daca40bf73d75eb0e88dcee80d57eec5d": "Leadership 1",
  "1c732c072364a2afd42a03228f3816fec37e73f64b61f4c12bab55ee": "Leadership 1",
  "91f5b1d436080c1beca93fbbb96596312d8f615b0ad9e94470af2224": "Leadership 2",
  "a1ebdcc53ad3907461d92204f9789ddb640dcdcb0d9fce786a55eaf4": "Leadership 2"
};

const TRUSTED_ENTITY_KEY_HASHES = {
  "ac3de68e8e1f9af3e00b299e7858bc44e126b33e130d06223d799d5d": "Cardano Foundation",
  "c9f2966a1b357718b45a006954106ba1f7ae9fea16e9826f3486ddd6": "Cardano Foundation",
  "1880102b04725318eb7a6f9f481815c82473c2f50cfe9932c85a3bf8": "Sundae Labs",
  "7a827787c47a4e74f102330cc8566ed9845047903121025911163b9d": "Sundae Labs",
  "a7f06cf4e9c03c6b7eac317d5533d573a9be3018fb7b9d95dd778d39": "Xerberus",
  "d8261e2c334b58072042130182de4fb945a46dd1b1974e1df755fe96": "Xerberus",
  "8349f8b41d8337b617947ace444ef95b2b80ff2605cadf969914cf95": "NMKR",
  "cd820bac2773f2df622c567aa547894177a818593bdae996dd0881e3": "NMKR",
  "679ad28e567eb42ddb30a5cf6b5f066b2defbce393f19968d711f658": "DQuadrant",
